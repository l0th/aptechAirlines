# Docker Compose connects backend to the bundled MongoDB service by default.
# Override this only when you intentionally use an external MongoDB server.
MONGO_URI=mongodb://mongodb:27017/airline_db
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
AIRLABS_API_KEY=
MAX_ADVANCE_BOOKING_DAYS=330

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Airline Reservation System <no-reply@airline.local>

PAYPAL_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PRESENTMENT_CURRENCY=USD
PAYPAL_VND_PER_PRESENTMENT_UNIT=25000
