{
  "name": "airline-reservation-backend",
  "version": "1.0.0",
  "description": "Airline Reservation System (ARS) Backend - NestJS & MongoDB",
  "author": "Antigravity Pair",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed:phase-a": "ts-node src/scripts/seed-phase-a.ts",
    "migrate:phase-b": "ts-node src/scripts/migrate-phase-b-seats.ts --execute",
    "migrate:phase-b:dry-run": "ts-node src/scripts/migrate-phase-b-seats.ts --dry-run",
    "repair:reference-data:dry-run": "ts-node src/scripts/repair-reference-data.ts --dry-run",
    "repair:reference-data": "ts-node src/scripts/repair-reference-data.ts --execute"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.4",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.1.2",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@types/tz-lookup": "^6.1.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "mongoose": "^8.2.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "rimraf": "^5.0.5",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
