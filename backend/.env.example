PORT=3000
MONGO_URI=mongodb://localhost:27017/airline_db
JWT_SECRET=your_jwt_secret_min_32_chars_here
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=your_secure_superadmin_password_here
SUPER_ADMIN_EMAIL=superadmin@airline.com
SUPER_ADMIN_FIRST_NAME=System
SUPER_ADMIN_LAST_NAME=SuperAdmin
AIRLABS_API_KEY=
# Maximum days in advance a user can book a flight
MAX_ADVANCE_BOOKING_DAYS=330

# Mail / SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Airline Reservation System <no-reply@airline.local>"

# PayPal Sandbox Configuration
PAYPAL_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PRESENTMENT_CURRENCY=USD
PAYPAL_VND_PER_PRESENTMENT_UNIT=25000
